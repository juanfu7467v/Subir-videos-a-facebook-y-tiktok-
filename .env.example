# ─────────────────────────────────────────────────────────────────────────────
# Copia este archivo como .env para desarrollo local
# NUNCA subas el archivo .env real a tu repositorio
# ─────────────────────────────────────────────────────────────────────────────

# ── Facebook ───────────────────────────────────────────────────────────────────
# Page Access Token con permiso publish_video
# Obtenerlo en: https://developers.facebook.com/tools/explorer/
FB_ACCESS_TOKEN=your_facebook_page_access_token_here

# ID numérico de tu página de Facebook (si no se usa, por defecto es "me")
FB_PAGE_ID=your_facebook_page_id_here

# ── TikTok ─────────────────────────────────────────────────────────────────────
# Access Token OAuth 2.0 del usuario autenticado
# Obtenerlo en: https://developers.tiktok.com/
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here

# Client Key de tu aplicación en TikTok for Developers
TIKTOK_APP_ID=your_tiktok_app_id_here

# ── Servidor ───────────────────────────────────────────────────────────────────
PORT=8080
TMP_DIR=/tmp/video_distributor
